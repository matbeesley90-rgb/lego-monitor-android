<?xml version="1.0" encoding="utf-8"?>
<!--
  LEGO brick silhouette for notification smallIcon.
  Monochrome (white on transparent) so Android tints it via
  NotificationCompat.Builder.setColor(int) — brand blue by default,
  Yellow / Amber for tier alerts.

  Shape: a 2x2-stud brick seen from a mild top-forward angle.
  - Base rectangle (the brick body)
  - Four circular studs on top
  - Small horizontal gap between top-of-body and studs suggests depth
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Brick body — chunky rounded rectangle -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M3,10 L21,10 L21,20 Q21,21 20,21 L4,21 Q3,21 3,20 Z" />

    <!-- Four studs on top — circles inset from body edges -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M7,7 m-2,0 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12,7 m-2,0 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M17,7 m-2,0 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0" />
</vector>
