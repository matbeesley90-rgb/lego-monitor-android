<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP/WS is blocked by default on Android 9+ (target SDK 28+).
  The Pi-hosted ntfy server speaks plain ws://81.96.120.250:8084 — TLS
  would need a cert + reverse proxy that we don't have yet. Scope the
  cleartext exception to ONLY the Pi's IP so the rest of the app still
  defaults to HTTPS-only.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">81.96.120.250</domain>
    </domain-config>
</network-security-config>
