<?xml version="1.0" encoding="utf-8"?>
<!--
  Collapsed (heads-up / lock-screen) layout.

  Tier stripes for at-a-glance differentiation:
    Yellow tier → 4dp coloured stripe across the TOP
    Amber tier  → 4dp coloured stripe down the LEFT edge
    Green / Fig / auction → no stripe
  Position (top vs left) + colour (yellow vs amber) together give
  fast visual differentiation that colour alone doesn't at a glance,
  especially on Samsung One UI's warm-tinted notification background.

  Root is a vertical LinearLayout so the top stripe can sit above
  everything else. Beneath it, a horizontal LinearLayout holds the
  left-edge stripe (Amber) and the existing thumb/title stack.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:orientation="vertical"
    android:background="@android:color/transparent">

    <!-- Yellow tier: TOP stripe. ImageView (not <View>) — Samsung's
         RemoteViews compositor sometimes drops bare Views. -->
    <ImageView
        android:id="@+id/notif_collapsed_top_stripe"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:scaleType="fitXY"
        android:contentDescription="@null"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

    <!-- Amber tier: LEFT-edge stripe. -->
    <ImageView
        android:id="@+id/notif_collapsed_stripe"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null"
        android:visibility="gone" />

    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:padding="8dp">

    <ImageView
        android:id="@+id/notif_thumb"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- Brand wordmark + " • <green pct>" — replaces the single title text -->
    <LinearLayout
        android:id="@+id/notif_title_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/notif_thumb"
        android:layout_marginStart="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/notif_brand_logo"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:adjustViewBounds="true"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/notif_title_tail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/notif_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/notif_thumb"
        android:layout_below="@id/notif_title_row"
        android:layout_marginStart="10dp"
        android:textSize="12sp"
        android:singleLine="true"
        android:ellipsize="end" />

    </RelativeLayout>

    </LinearLayout>

</LinearLayout>
