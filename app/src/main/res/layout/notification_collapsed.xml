<?xml version="1.0" encoding="utf-8"?>
<!--
  Collapsed (heads-up / lock-screen) layout. One-line summary:
  [thumbnail]  Vinted • 56%  TIE Fighter Pilot Helmet · 75274
  Brand colour applied to "Vinted" at render time via setTextColor.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:padding="8dp"
    android:background="@android:color/transparent">

    <ImageView
        android:id="@+id/notif_thumb"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- Brand wordmark + " • <green pct>" — replaces the single title text -->
    <LinearLayout
        android:id="@+id/notif_title_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/notif_thumb"
        android:layout_marginStart="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/notif_brand_logo"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:adjustViewBounds="true"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/notif_title_tail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/notif_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/notif_thumb"
        android:layout_below="@id/notif_title_row"
        android:layout_marginStart="10dp"
        android:textSize="12sp"
        android:singleLine="true"
        android:ellipsize="end" />

</RelativeLayout>
