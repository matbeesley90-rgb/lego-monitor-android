<?xml version="1.0" encoding="utf-8"?>
<!--
  Expanded layout — V2 (2026-06-29).

  Vertical stack: title → set name → grid row 1 (New) → grid row 2 (Used)
  → thumbnail at the bottom. Text gets the full notification width
  (instead of sharing horizontal space with the thumb), and each grid
  row is FOUR separate TextViews in a horizontal LinearLayout with
  explicit weights — that way cells stay side-by-side regardless of
  text length and Android can't wrap one cell's content into the next.

  Cells:
    price    │   B?: £X +Y%        E?: £X +Y%
    [r?_price] [r?_div] [r?_cell_a]    [r?_cell_b]
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Title row: brand wordmark (image) + " • " + green pct + optional " • 🔨 timer" -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/notif_brand_logo"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:adjustViewBounds="true"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/notif_title_tail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textSize="16sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/notif_setname"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:singleLine="true"
        android:ellipsize="end"
        android:layout_marginTop="2dp" />

    <!-- Grid row 1: New prices -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/notif_r1_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#3B98E0"
            android:minWidth="72dp" />
        <TextView
            android:id="@+id/notif_r1_div"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="#555555"
            android:paddingStart="10dp"
            android:paddingEnd="12dp"
            android:text="│" />
        <TextView
            android:id="@+id/notif_r1_cell_a"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginEnd="6dp" />
        <TextView
            android:id="@+id/notif_r1_cell_b"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Grid row 2: Used prices -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/notif_r2_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#F5AF02"
            android:minWidth="72dp" />
        <TextView
            android:id="@+id/notif_r2_div"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="#555555"
            android:paddingStart="10dp"
            android:paddingEnd="12dp"
            android:text="│" />
        <TextView
            android:id="@+id/notif_r2_cell_a"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginEnd="6dp" />
        <TextView
            android:id="@+id/notif_r2_cell_b"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <ImageView
        android:id="@+id/notif_thumb"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_marginTop="10dp"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:contentDescription="@null" />

</LinearLayout>
