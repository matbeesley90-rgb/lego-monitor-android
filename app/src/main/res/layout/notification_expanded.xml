<?xml version="1.0" encoding="utf-8"?>
<!--
  Expanded layout (big content). Mirrors the V4 design:

    [thumb]   Vinted • 56%                    [thumbnail right-aligned]
              TIE Fighter Pilot Helmet · 75274
              £63.00  │  B N: £240 +71%   E N: £300 +77%
              £70.35  │  B U: £159 +56%   E U: £139 +49%

  Brand colour + typeface set at render time via setTextColor +
  setTypeface (where supported by RemoteViews — Android 13+).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/notif_thumb"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notif_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/notif_setname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/notif_grid_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/notif_grid_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />

    </LinearLayout>

</LinearLayout>
